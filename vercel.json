{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/|.*\\.json$|robots\\.txt$|sitemap\\.xml$|og\\.(?:jpg|svg)$|favicon(?:-192)?\\.(?:svg|jpg)$|apple-touch-icon\\.jpg$).*)",
      "destination": "/index.html"
    }
  ]
}
